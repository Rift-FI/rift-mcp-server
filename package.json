{
  "name": "@rift-finance/mcp-server",
  "version": "2.0.0",
  "description": "MCP server for Rift Finance SDK and API documentation - enables AI assistants to query endpoints, types, and usage examples. v2 adds HTTP transport for claude.ai connectors.",
  "main": "dist/index.js",
  "bin": {
    "rift-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "dev": "npx ts-node src/index.ts",
    "dev:http": "MCP_TRANSPORT=http npx ts-node src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
